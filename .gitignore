# --- Dependencias y artefactos de compilación -------------------------------
# node_modules son ~50 MB que se reconstruyen con `npm install`: nunca se sube.
# dist/ lo genera GitHub Actions en cada push, tampoco hace falta subirlo.
node_modules/
dist/
.vite/

# --- Registros y temporales -------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# --- Certificados del servidor de desarrollo --------------------------------
# vite-plugin-basic-ssl los genera solo; son de esta máquina y no deben viajar.
*.pem
*.key
.cert/

# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editores ---------------------------------------------------------------
.vscode/
.idea/
*.swp

# --- Enunciado original del proyecto ----------------------------------------
# Es tu documento de partida, no forma parte de la aplicación, así que por
# defecto se queda en tu máquina y no se publica.
# Si preferís que se vea en el repositorio, borrá la línea siguiente.
Prompt.txt
